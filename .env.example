# =====================================================================
# Stub environment
# Copy to .env and fill. NEVER commit .env. NEVER put a private key in VITE_* vars
# (anything starting with VITE_ is shipped to the browser).
# =====================================================================

# ---------- Network (switch testnet -> mainnet only at the end) ----------
# testnet | mainnet
VITE_CHAIN=testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
VITE_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# USDC ERC-20 interface on Arc (same address on testnet & mainnet, 6 decimals)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---------- Wallets (public addresses only) ----------
# contract admin (your main wallet)
OWNER_ADDRESS=
# receives protocol fee
FEE_RECIPIENT_ADDRESS=
# receives service revenue
MERCHANT_ADDRESS=
# SEPARATE hot wallet used by the gateway
FULFILLER_ADDRESS=

# ---------- Contract (fill after deploy) ----------
# 3%  (max 500)
PROTOCOL_FEE_BPS=300
# StubEscrow address after deploy
VITE_ESCROW_ADDRESS=
# Pitch Brief service id after RegisterService
VITE_SERVICE_ID=1
# block of the escrow deploy tx (feed scans from here)
VITE_ESCROW_DEPLOY_BLOCK=
# 6 decimals -> 0.05 USDC
SERVICE_PRICE_UNITS=50000
# 10 min to deliver, else buyer can refund
SERVICE_TIMEOUT_SECONDS=600

# ---------- Server-only secrets (Vercel env, never in VITE_*) ----------
# hot wallet key, keep < $1 USDC in it
FULFILLER_PRIVATE_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Vercel Marketplace -> Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Frontend ----------
VITE_API_BASE=/api
# optional, https://dashboard.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# ---------- Arc Studio CLI (local only, never commit, never VITE_) ----------
# From https://studio.arc.io/cli-auth -> Authorize. Revoke after the hackathon.
ARC_STUDIO_TOKEN=
