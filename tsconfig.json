// Root project: the server/tooling side of the repo, with the same compilerOptions Vercel uses.
//
// Two things depend on this file:
//  1. Vercel's @vercel/node builder type-checks every api/*.ts entrypoint against it. With no
//     compilerOptions it falls back to non-strict + ES5, which makes zod infer every field as
//     optional (TS1360) and collapses viem's account / chain / authorizationList types.
//     Keep these options in sync with tsconfig.api.json. (DOM is in "lib" only because
//     examples/paywall-server.ts needs HeadersInit; tsconfig.api.json stays ES2022-only and is
//     still the stricter gate, since Vercel runs npm run build -> npm run typecheck.)
//  2. VS Code attributes a file to a project whose "include" matches it. Without the include below,
//     files only tsconfig.node.json covers (examples/, tests/, apps/, packages/, lib/dev/) got
//     attributed to tsconfig.app.json, whose types are ["vite/client"] - hence "Cannot find name
//     'process'" in the editor while npm run typecheck passed.
//
// "src" is deliberately absent: it belongs to tsconfig.app.json, which has no node types so
// browser code cannot reach for process/Buffer by accident. No "references" either - they make
// tsc treat the referenced projects' .d.ts as prebuilt outputs (TS6305) since none are composite.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "api",
    "lib",
    "examples",
    "tests",
    "packages",
    "apps",
    "shared"
  ],
  "exclude": [
    "lib/openzeppelin-contracts",
    "lib/forge-std"
  ]
}
