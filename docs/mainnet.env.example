# Reference only: NOT automatically loaded by Vite or Foundry.
# Keep testnet .env unchanged. See MAINNET.md. Public deployment reference; never load it over the testnet .env.
# Never add secret values to this tracked template.
VITE_CHAIN=mainnet
VITE_ESCROW_ADDRESS=0xf294eCC15b52A5c7Ab7466885b8a033CB92C85c1
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_SERVICE_ID=1
VITE_ESCROW_DEPLOY_BLOCK=28670061
VITE_API_BASE=/api
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
VITE_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# Optional supported fallbacks: public reads; server wallet uses primary RPC.
RPC_URL_FALLBACK=https://rpc.drpc.mainnet.arc.io
VITE_RPC_URL_FALLBACK=https://rpc.drpc.mainnet.arc.io
# Browser RPC URLs must be public/CORS-enabled; never include private provider keys.

# Deployment / registration public values.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
OWNER_ADDRESS=0x075FF540a0F8e9340a4813EF96C609Dc203A3041
FEE_RECIPIENT_ADDRESS=0x075FF540a0F8e9340a4813EF96C609Dc203A3041
FULFILLER_ADDRESS=0x499b7494b08163d867286b31fF25Fcd1038e03Ae
# Existing deployed settings; no deployment or service registration is needed.
PROTOCOL_FEE_BPS=300
SERVICE_PRICE_UNITS=10000
SERVICE_TIMEOUT_SECONDS=600
# RegisterService's signing account becomes merchant; MERCHANT_ADDRESS is not read.

# Server only: set in Vercel Production, never in this template or VITE_*.
FULFILLER_PRIVATE_KEY=
GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use separate production Redis credentials, never the testnet database.
# Preserve existing working AI settings / server defaults.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
